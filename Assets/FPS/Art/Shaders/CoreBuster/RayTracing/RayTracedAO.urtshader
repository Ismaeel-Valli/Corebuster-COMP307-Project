// CoreBuster ray-traced ambient occlusion (Ultra quality, ray tracing on).
// A Unified Ray Tracing shader: Unity imports it twice, as a compute shader that walks a software BVH on any GPU with
// compute support, and as a DXR ray-generation shader for GPUs with hardware ray tracing (DX12).
// Each traced pixel rebuilds its world position from the camera depth, then casts cosine-distributed rays over the
// hemisphere around the camera-normals direction against the level's acceleration structure. Nearby hits occlude
// more than distant ones. The output is (visibility, distance to camera), denoised by RayTracedAODenoise.compute.

#pragma only_renderers d3d11 vulkan metal glcore xboxseries ps5

#define UNIFIED_RT_GROUP_SIZE_X 8
#define UNIFIED_RT_GROUP_SIZE_Y 8

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Sampling/Sampling.hlsl"
#include "Packages/com.unity.render-pipelines.core/Runtime/UnifiedRayTracing/TraceRayAndQueryHit.hlsl"

UNIFIED_RT_DECLARE_ACCEL_STRUCT(_AccelStruct);

Texture2D<float> _RTAO_Depth;
Texture2D<float4> _RTAO_Normals;
RWTexture2D<float2> _RTAO_Output;

float4x4 _RTAO_InvViewProj;
float4 _RTAO_TraceSize;     // xy: traced size, zw: 1 / size
float4 _RTAO_DepthSize;     // xy: depth/normals size
float4 _RTAO_CameraPos;
float _RTAO_Radius;
float _RTAO_FlipY;          // +1 or -1: matches texture rows to clip-space Y on this graphics API
int _RTAO_RayCount;
int _RTAO_Frame;

uint PcgHash(uint v)
{
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float Random01(inout uint seed)
{
    seed = PcgHash(seed);
    return (seed & 0x00FFFFFFu) / 16777216.0;
}

void RayGenExecute(UnifiedRT::DispatchInfo dispatchInfo)
{
    uint2 pixel = dispatchInfo.dispatchThreadID.xy;
    float2 uv = (pixel + 0.5) * _RTAO_TraceSize.zw;
    int2 source = min(int2(uv * _RTAO_DepthSize.xy), int2(_RTAO_DepthSize.xy) - 1);
    float depth = _RTAO_Depth.Load(int3(source, 0));

#if UNITY_REVERSED_Z
    bool sky = depth <= 1e-7;
#else
    bool sky = depth >= 1.0 - 1e-7;
#endif
    float3 normal = _RTAO_Normals.Load(int3(source, 0)).xyz;
    if (sky || dot(normal, normal) < 1e-4)
    {
        _RTAO_Output[pixel] = float2(1.0, 0.0);
        return;
    }
    normal = normalize(normal);

    float2 ndc = uv * 2.0 - 1.0;
    ndc.y *= _RTAO_FlipY;
    float4 world = mul(_RTAO_InvViewProj, float4(ndc, depth, 1.0));
    float3 position = world.xyz / world.w;
    float viewDistance = length(position - _RTAO_CameraPos.xyz);

    UnifiedRT::RayTracingAccelStruct accelStruct = UNIFIED_RT_GET_ACCEL_STRUCT(_AccelStruct);
    uint seed = PcgHash(pixel.x + pixel.y * 8191u) ^ PcgHash((uint)_RTAO_Frame * 9781u + 1u);

    UnifiedRT::Ray ray;
    // Pushed off the surface in proportion to the distance, as depth precision falls off with it.
    ray.origin = position + normal * (0.015 + 0.0015 * viewDistance);
    ray.tMin = 0.0;
    ray.tMax = _RTAO_Radius;

    float occlusion = 0.0;
    for (int i = 0; i < _RTAO_RayCount; i++)
    {
        float u1 = Random01(seed);
        float u2 = Random01(seed);
        ray.direction = SampleHemisphereCosine(u1, u2, normal);
        UnifiedRT::Hit hit = UnifiedRT::TraceRayClosestHit(dispatchInfo, accelStruct, 0xFFFFFFFF, ray, 0);
        if (hit.IsValid())
        {
            float k = saturate(hit.hitDistance / _RTAO_Radius);
            occlusion += 1.0 - k * k;
        }
    }

    _RTAO_Output[pixel] = float2(1.0 - occlusion / max(1, _RTAO_RayCount), viewDistance);
}
